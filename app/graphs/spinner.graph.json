    { "id": "turn", "type": "math.multiply", "position": [210, 110] },
    { "id": "turn_vec", "type": "vector.combine3", "position": [390, 140] },
    { "id": "time", "type": "input.time", "position": [0, 330] },
    { "id": "pulse", "type": "input.parameter", "position": [0, 420], "values": { "name": "pulse" } },
    { "id": "speedup", "type": "math.multiply", "position": [210, 330] },
