  "version": 1,
  "kind": "logic",
  "name": "spinner",
  "nodes": [
    { "id": "about", "type": "graph.comment", "position": [0, -110], "values": { "text": "Every tick: turn around y by spin × delta, then set the scale to 1 + 0.15 × sin(time × pulse). spin and pulse are this graph's parameters.", "width": 760, "height": 80 } },
